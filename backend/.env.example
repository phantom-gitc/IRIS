# ============================================================
# IRIS BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ============================================================
# Do NOT place actual production secrets into this template.

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB)
# Supports either MONGO_URI or MONGODB_URI
MONGO_URI=mongodb://localhost:27017/iris
MONGODB_URI=mongodb://localhost:27017/iris

# Vector Database (Qdrant)
# Supports either QDRANT_CLUSTER_ENDPOINT or QDRANT_URL
QDRANT_CLUSTER_ENDPOINT=https://your-qdrant-cluster.qdrant.io:6333
QDRANT_URL=https://your-qdrant-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# JWT Authentication
# Supports either ACCESS_TOKEN_SECRET / REFRESH_TOKEN_SECRET or JWT_ACCESS_SECRET / JWT_REFRESH_SECRET
ACCESS_TOKEN_SECRET=your_jwt_access_secret_min_32_chars_long
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
JWT_SECRET=your_fallback_jwt_secret

# AI & Voice Providers
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# LiveKit Realtime Voice
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Email (SMTP for account verification & password resets)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=no-reply@iris.ai
